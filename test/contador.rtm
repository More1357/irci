.section ".text"

addi $sp, $zero, 0xFFC

addi $s2, $zero, -0x100

addi $s0, $zero, 49

addi $s1, $zero, 57

bucle:
    sb $s0, 0($s2)

    addi $t0, $zero, '\r'
    sb $t0, 0($s2)
    addi $t0, $zero, '\n'
    sb $t0, 0($s2)

    addi $s0, $s0, 1

    slt $t0, $s1, $s0        
    beq $t0, $zero, bucle   

    trap 1
